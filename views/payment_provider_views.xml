<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="payment_provider_form" model="ir.ui.view">
        <field name="name">payment.provider.form.kamipay</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='provider_credentials']" position="inside">
                <group invisible="code != 'kamipay'">
                    <field name="kamipay_api_key" required="code == 'kamipay' and state != 'disabled'" password="True"/>
                    <field name="kamipay_api_secret" required="code == 'kamipay' and state != 'disabled'" password="True"/>
                    <field name="kamipay_signature_key" required="code == 'kamipay' and state != 'disabled'" password="True"/>
                    <field name="kamipay_wallet_address" required="code == 'kamipay' and state != 'disabled'"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
