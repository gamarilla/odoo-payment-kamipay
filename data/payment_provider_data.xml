<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="payment_provider_kamipay" model="payment.provider">
        <field name="name">PIX (KamiPay)</field>
        <field name="code">kamipay</field>
        <field name="state">disabled</field>
        <field name="company_id" ref="base.main_company"/>
        <field name="redirect_form_view_id" ref="redirect_form"/>
        <field name="image_128" type="base64" file="payment_kamipay/static/description/icon.png"/>
        <field name="payment_method_ids" eval="[Command.set([ref('payment.payment_method_pix')])]"/>
        <field name="pending_msg" type="html"><p>Escanee el código QR con la app de su banco. El pago se confirma en segundos.</p></field>
    </record>
</odoo>
